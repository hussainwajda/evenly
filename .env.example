# Copy to .env.local and fill in from Supabase → Project Settings → API Keys.
# Both values are designed to be public (they ship inside the app); Row Level Security protects the data.
# Leave them empty to run Evenly local-only (no sign-in, no sync).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
